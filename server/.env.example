PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/showtime
# Comma-separated list of allowed browser origins (the Vite dev server by default)
CLIENT_ORIGIN=http://localhost:3000

# Only if you see "querySrv ECONNREFUSED" with an Atlas mongodb+srv:// URI:
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ---- Razorpay (https://dashboard.razorpay.com -> Account & Settings -> API Keys; use TEST keys first) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional but recommended: Dashboard -> Webhooks -> add https://<your-api>/api/payments/webhook
# with events payment.captured + order.paid, and put the secret you choose here.
RAZORPAY_WEBHOOK_SECRET=
# Minutes seats stay reserved while the customer is paying
HOLD_MINUTES=15
